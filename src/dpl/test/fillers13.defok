ROW ROW_0_L StdSite 0 0 N DO 6 BY 1 STEP 380 0 ;
ROW ROW_1_L StdSite 0 2800 FS DO 6 BY 1 STEP 380 0 ;
ROW ROW_0_R DblSite 2280 0 N DO 6 BY 1 STEP 380 0 ;
COMPONENTS 6 ;
    - FILLER_0_0 FILL_X4 + SOURCE DIST + PLACED ( 0 0 ) N ;
    - FILLER_0_10 FILL2_X2 + SOURCE DIST + PLACED ( 3800 0 ) N ;
    - FILLER_0_4 FILL_X2 + SOURCE DIST + PLACED ( 1520 0 ) N ;
    - FILLER_0_6 FILL2_X4 + SOURCE DIST + PLACED ( 2280 0 ) N ;
    - FILLER_1_0 FILL_X4 + SOURCE DIST + PLACED ( 0 2800 ) FS ;
    - FILLER_1_4 FILL_X2 + SOURCE DIST + PLACED ( 1520 2800 ) FS ;
END COMPONENTS
NETS 0 ;
