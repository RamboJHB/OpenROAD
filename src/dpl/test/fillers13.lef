    PORT
      LAYER metal1 ;
        RECT 0 -0.085 0.76 0.085 ;
    END
  END VSS
END FILL_X4

# 2x filler cells (height = 2.8 um)
MACRO FILL2_X1
  CLASS CORE SPACER ;
  ORIGIN 0 0 ;
  SIZE 0.19 BY 2.8 ;
  SYMMETRY X Y ;
  SITE DblSite ;
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    SHAPE ABUTMENT ;
    PORT
      LAYER metal1 ;
        RECT 0 2.715 0.19 2.885 ;
    END
  END VDD
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    SHAPE ABUTMENT ;
    PORT
      LAYER metal1 ;
        RECT 0 -0.085 0.19 0.085 ;
    END
  END VSS
END FILL2_X1

