VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 1000 ;

DIEAREA ( 0 0 ) ( 2000 1000 ) ;

ROW ROW_0 core 0 0 N DO 10 BY 1 STEP 200 0 ;

COMPONENTS 3 ;
  - cellL0 CELL_L + PLACED ( 0 0 ) N ;
  - dirtyF FILL_L6 + PLACED ( 400 0 ) N ;
  - cellL1 CELL_L + PLACED ( 1600 0 ) N ;
END COMPONENTS

END DESIGN
