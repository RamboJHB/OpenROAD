VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN drc_test_pg ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 20000 20000 ) ;
ROW ROW_0 FreePDK45_38x28_10R_NP_162NW_34O 2000 2800 N DO 40 BY 1 STEP 380 0 ;
TRACKS X 190 DO 52 STEP 380 LAYER metal1 ;
TRACKS Y 140 DO 70 STEP 280 LAYER metal1 ;
TRACKS X 190 DO 52 STEP 380 LAYER metal2 ;
TRACKS Y 140 DO 70 STEP 280 LAYER metal2 ;
TRACKS X 190 DO 52 STEP 380 LAYER metal3 ;
TRACKS Y 140 DO 70 STEP 280 LAYER metal3 ;
GCELLGRID X 0 DO 11 STEP 2000 ;
GCELLGRID Y 0 DO 11 STEP 2000 ;
COMPONENTS 2 ;
    - inst1 INV_X1 + PLACED ( 2000 2800 ) N ;
    - inst2 INV_X1 + PLACED ( 8000 2800 ) N ;
END COMPONENTS
NETS 2 ;
    - net1 ( inst1 ZN ) ( inst2 A )
      + ROUTED metal1 ( 12000 14000 ) ( 16000 14000 )
        NEW metal2 ( 8000 8000 ) ( 10000 8000 ) ;
    - net2 ( inst2 ZN ) ( inst1 A )
      + ROUTED metal1 ( 14000 12000 ) ( 14000 16000 )
        NEW metal2 ( 12370 7000 ) ( 12370 9000 ) ;
END NETS
SPECIALNETS 2 ;
    - VDD ( * VDD ) + USE POWER
      + ROUTED metal2 400 + SHAPE STRIPE ( 3000 7000 ) ( 3000 9000 )
      NEW metal2 400 + SHAPE STRIPE ( 6000 7000 ) ( 6000 9000 )
      NEW metal2 400 + SHAPE STRIPE ( 9000 7000 ) ( 9000 9000 )
      NEW metal2 400 + SHAPE STRIPE ( 12000 7000 ) ( 12000 9000 )
      NEW metal2 400 + SHAPE STRIPE ( 15000 7000 ) ( 15000 9000 )
      NEW metal2 400 + SHAPE STRIPE ( 18000 7000 ) ( 18000 9000 )
      NEW metal2 100 + SHAPE STRIPE ( 3000 12000 ) ( 3000 14000 )
      NEW metal2 400 + SHAPE STRIPE ( 6005 12000 ) ( 6005 14000 )
      NEW metal1 0 + SHAPE STRIPE ( 3000 17000 ) via1_4
      NEW metal1 0 + SHAPE STRIPE ( 3290 17000 ) via1_4
      NEW metal2 400 + SHAPE STRIPE ( 200 7000 ) ( 200 9000 ) ;
    - VSS ( * VSS ) + USE GROUND
      + ROUTED metal2 400 + SHAPE STRIPE ( 2000 8000 ) ( 4000 8000 )
      NEW metal2 400 + SHAPE STRIPE ( 6500 7000 ) ( 6500 9000 ) ;
END SPECIALNETS
BLOCKAGES 2 ;
    - LAYER metal2 RECT ( 14000 7800 ) ( 16000 8200 ) ;
    - LAYER metal2 RECT ( 18300 7000 ) ( 18600 9000 ) ;
END BLOCKAGES
END DESIGN
