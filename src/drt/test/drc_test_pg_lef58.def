VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN drc_test_pg_lef58 ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 164000 104000 ) ;
ROW ROW_0 FreePDK45_38x28_10R_NP_162NW_34O 2000 2800 N DO 200 BY 1 STEP 380 0 ;
TRACKS X 190 DO 431 STEP 380 LAYER metal1 ;
TRACKS Y 140 DO 371 STEP 280 LAYER metal1 ;
TRACKS X 190 DO 431 STEP 380 LAYER metal2 ;
TRACKS Y 140 DO 371 STEP 280 LAYER metal2 ;
TRACKS X 190 DO 431 STEP 380 LAYER metal3 ;
TRACKS Y 140 DO 371 STEP 280 LAYER metal3 ;
GCELLGRID X 0 DO 83 STEP 2000 ;
GCELLGRID Y 0 DO 53 STEP 2000 ;
COMPONENTS 1 ;
    - inst1 INV_X1 + PLACED ( 2000 2800 ) N ;
END COMPONENTS
NETS 1 ;
