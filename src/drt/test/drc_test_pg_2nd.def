VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN drc_test_pg_2nd ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 20000 20000 ) ;
ROW ROW_0 FreePDK45_38x28_10R_NP_162NW_34O 2000 2800 N DO 40 BY 1 STEP 380 0 ;
TRACKS X 190 DO 52 STEP 380 LAYER metal1 ;
TRACKS Y 140 DO 70 STEP 280 LAYER metal1 ;
TRACKS X 190 DO 52 STEP 380 LAYER metal2 ;
TRACKS Y 140 DO 70 STEP 280 LAYER metal2 ;
TRACKS X 190 DO 52 STEP 380 LAYER metal3 ;
TRACKS Y 140 DO 70 STEP 280 LAYER metal3 ;
GCELLGRID X 0 DO 11 STEP 2000 ;
GCELLGRID Y 0 DO 11 STEP 2000 ;
COMPONENTS 2 ;
    - inst1 INV_X1 + PLACED ( 2000 2800 ) N ;
    - inst2 INV_X1 + PLACED ( 8000 2800 ) N ;
END COMPONENTS
NETS 1 ;
    - sig1 ( inst1 ZN ) ( inst2 A )
      + ROUTED metal2 ( 5130 11000 ) ( 5130 14000 ) ;
END NETS
SPECIALNETS 2 ;
    - VDD ( * VDD ) + USE POWER
      + ROUTED metal4 800 + SHAPE STRIPE ( 4000 2000 ) ( 4000 18000 )
      NEW metal4 800 + SHAPE STRIPE ( 8000 2000 ) ( 8000 18000 )
      NEW metal4 800 + SHAPE STRIPE ( 12000 2000 ) ( 12000 18000 )
      NEW metal4 800 + SHAPE STRIPE ( 16000 2000 ) ( 16000 18000 )
      NEW metal5 800 + SHAPE STRIPE ( 2000 6000 ) ( 18000 6000 )
      NEW metal5 800 + SHAPE STRIPE ( 2000 16000 ) ( 18000 16000 )
      NEW metal2 400 + SHAPE STRIPE ( 2000 14500 ) ( 5510 14500 )
      NEW metal2 400 + SHAPE STRIPE ( 5510 11000 ) ( 5510 14500 ) ;
    - VSS ( * VSS ) + USE GROUND
      + ROUTED metal4 800 + SHAPE STRIPE ( 6000 2000 ) ( 6000 18000 )
      NEW metal4 800 + SHAPE STRIPE ( 10000 2000 ) ( 10000 18000 )
      NEW metal4 800 + SHAPE STRIPE ( 14000 2000 ) ( 14000 18000 )
      NEW metal5 800 + SHAPE STRIPE ( 2000 10000 ) ( 18000 10000 ) ;
END SPECIALNETS
END DESIGN
