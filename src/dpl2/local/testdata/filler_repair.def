VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN filler_repair_real_odb ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 2000 2000 ) ;
ROW ROW_0 core 0 0 FS DO 20 BY 1 STEP 100 0 ;
ROW ROW_1 core 0 1000 N DO 20 BY 1 STEP 100 0 ;
COMPONENTS 16 ;
- U0 TL4 + PLACED ( 0 0 ) FS ;
- F00 FL2 + PLACED ( 400 0 ) FS ;
- F01 FL2 + PLACED ( 600 0 ) FS ;
- U1 TL4 + PLACED ( 800 0 ) FS ;
- F02 FL2 + PLACED ( 1200 0 ) FS ;
- F03 FL2 + PLACED ( 1400 0 ) FS ;
- F04 FL2 + PLACED ( 1600 0 ) FS ;
- F05 FL2 + PLACED ( 1800 0 ) FS ;
- U2 TH4 + PLACED ( 0 1000 ) N ;
- F10 FH2 + PLACED ( 400 1000 ) N ;
- F11 FH2 + PLACED ( 600 1000 ) N ;
- U3 TH4 + PLACED ( 800 1000 ) N ;
- F12 FH2 + PLACED ( 1200 1000 ) N ;
- F13 FH2 + PLACED ( 1400 1000 ) N ;
- F14 FH2 + PLACED ( 1600 1000 ) N ;
- F15 FH2 + PLACED ( 1800 1000 ) N ;
END COMPONENTS
END DESIGN
